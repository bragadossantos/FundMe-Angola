APP_NAME="FundMe Angola"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Luanda
APP_URL=http://localhost

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Overridden by real DB_CONNECTION/DB_URL environment variables injected by the
# hosting platform (see render.yaml). sqlite here is only a safe local fallback
# so the app can still boot if no database env vars are present.
DB_CONNECTION=sqlite

# Database-backed session/cache/queue so state survives container restarts —
# do NOT use "file"/"sync" in production, the container filesystem is ephemeral.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
